{
  "entities": {
    "edc": {
      "title": "Asset (EDC device, SIM card, or peripheral)",
      "description": "A single trackable asset. SIMs and peripherals may be linked to a parent device and then follow its status, customer and location.",
      "type": "object",
      "properties": {
        "sn": {
          "type": "string",
          "description": "Serial Number"
        },
        "tid": {
          "type": "string",
          "description": "Terminal ID"
        },
        "mid": {
          "type": "string",
          "description": "Merchant ID"
        },
        "vendor": {
          "type": "string",
          "description": "Brand / Vendor"
        },
        "model": {
          "type": "string",
          "description": "Model Name"
        },
        "osVersion": {
          "type": "string",
          "description": "OS or App Version"
        },
        "provider": {
          "type": "string",
          "description": "SIM Provider"
        },
        "imei": {
          "type": "string",
          "description": "IMEI / ICCID"
        },
        "status": {
          "type": "string",
          "enum": [
            "Incoming Stock",
            "Available in Warehouse",
            "Staged / Ready",
            "Reserved / Allocated",
            "In Delivery",
            "Installed / Active",
            "Withdrawn",
            "Under Repair",
            "Damaged",
            "Lost",
            "Returned to Supplier",
            "Retired"
          ],
          "description": "Current status of the device"
        },
        "condition": {
          "type": "string",
          "enum": [
            "New",
            "Refurbished",
            "Second"
          ],
          "description": "Physical condition"
        },
        "currentLocationId": {
          "type": "string",
          "description": "Reference to location"
        },
        "currentCustomerId": {
          "type": "string",
          "description": "Reference to customer"
        },
        "customerName": {
          "type": "string",
          "description": "Denormalized customer name"
        },
        "contractStartDate": {
          "type": "string",
          "format": "date-time"
        },
        "expectedEndDate": {
          "type": "string",
          "format": "date-time"
        },
        "contractEndDateActual": {
          "type": "string",
          "format": "date-time"
        },
        "contractStatus": {
          "type": "string",
          "enum": [
            "Active",
            "Terminated (Normal)",
            "Terminated (Early)"
          ]
        },
        "penaltyAmount": {
          "type": "number"
        },
        "partPenaltyAmount": {
          "type": "number"
        },
        "currentMonthlyRental": {
          "type": "number"
        },
        "damagedParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastUpdatedBy": {
          "type": "string",
          "description": "UID of user who last updated"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "assetType": {
          "type": "string",
          "enum": [
            "perangkat",
            "sim",
            "peripheral"
          ]
        },
        "msisdn": {
          "type": "string"
        },
        "simType": {
          "type": "string",
          "enum": [
            "Public",
            "Private"
          ]
        },
        "peripheralType": {
          "type": "string",
          "enum": [
            "Charger",
            "Battery",
            "Modem",
            "Dongle",
            "Lainnya"
          ]
        },
        "parentDeviceId": {
          "type": "string",
          "description": "Parent device id (SIM / peripheral only)"
        },
        "parentDeviceSN": {
          "type": "string"
        },
        "locationName": {
          "type": "string",
          "description": "Denormalized location name"
        },
        "contractScheme": {
          "type": "string"
        },
        "contractCustomerId": {
          "type": "string",
          "description": "Customer of the current / last contract; kept after withdrawal"
        },
        "contractCustomerName": {
          "type": "string"
        },
        "contractLocationId": {
          "type": "string"
        },
        "contractLocationName": {
          "type": "string"
        },
        "remainingMonthsAtTermination": {
          "type": "number"
        },
        "isTerminatedInARO": {
          "type": "boolean"
        },
        "hasBA": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "statusSince": {
          "type": "string",
          "format": "date-time",
          "description": "Since when the unit is in its current status (aging)"
        },
        "assetTag": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "supplierId": {
          "type": "string"
        },
        "supplierName": {
          "type": "string"
        },
        "poNumber": {
          "type": "string"
        },
        "deliveryNoteNo": {
          "type": "string"
        },
        "receivedDate": {
          "type": "string",
          "format": "date-time"
        },
        "purchasePrice": {
          "type": "number"
        },
        "warrantyUntil": {
          "type": "string",
          "format": "date-time"
        },
        "connectionType": {
          "type": "string"
        },
        "installedDate": {
          "type": "string",
          "format": "date-time"
        },
        "lastVisitDate": {
          "type": "string",
          "format": "date-time"
        },
        "lastTechnician": {
          "type": "string"
        },
        "repairCount": {
          "type": "number"
        },
        "repairCostTotal": {
          "type": "number"
        },
        "disposalMethod": {
          "type": "string"
        },
        "disposalDate": {
          "type": "string",
          "format": "date-time"
        },
        "disposalValue": {
          "type": "number"
        },
        "lastApprovalId": {
          "type": "string",
          "description": "Approval that authorized the latest closing status change"
        }
      },
      "required": [
        "sn",
        "status",
        "assetType"
      ]
    },
    "customer": {
      "title": "B2B Customer",
      "description": "Enterprise customer or merchant.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "picName": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "address": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "contractDuration": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "location": {
      "title": "Location",
      "description": "Merchant outlet (owned by a customer), warehouse, or service center.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Warehouse",
            "Merchant Site",
            "Service Center"
          ]
        },
        "address": {
          "type": "string"
        },
        "customerId": {
          "type": "string",
          "description": "Owning customer (required for Merchant Site)"
        },
        "city": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "picName": {
          "type": "string"
        },
        "picPhone": {
          "type": "string"
        },
        "merchantCode": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "contract": {
      "title": "Contract",
      "description": "LEGACY, unused. Contracts now live on each asset document.",
      "type": "object",
      "properties": {
        "contractNumber": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "Sewa",
            "Managed Service",
            "Jual Putus",
            "Pinjam Pakai",
            "Konsinyasi"
          ]
        },
        "value": {
          "type": "number"
        },
        "sla": {
          "type": "string"
        }
      },
      "required": [
        "contractNumber",
        "customerId",
        "startDate",
        "endDate"
      ]
    },
    "movement": {
      "title": "EDC Movement",
      "description": "Log of a single device movement or status change.",
      "type": "object",
      "properties": {
        "edcId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Goods Receipt | QC Pass | Return to Supplier | Staging | Warehouse Transfer | Allocation | Delivery | Install | Relocation | Maintenance | Swap Out | Swap In | Repair | Return to Stock | Withdrawal | Write-off | Lost | Disposal | Cancel Termination"
        },
        "fromStatus": {
          "type": "string"
        },
        "toStatus": {
          "type": "string"
        },
        "toLocationId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "transactionDate": {
          "type": "string",
          "format": "date"
        },
        "baGenerated": {
          "type": "boolean"
        },
        "baData": {
          "type": "object",
          "properties": {
            "templateType": {
              "type": "string"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "customerPIC": {
              "type": "string"
            },
            "technician": {
              "type": "string"
            },
            "customerAddress": {
              "type": "string"
            }
          }
        },
        "userId": {
          "type": "string"
        },
        "userName": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "sn": {
          "type": "string",
          "description": "Denormalized serial number"
        },
        "customerName": {
          "type": "string"
        },
        "toLocationName": {
          "type": "string"
        },
        "batchId": {
          "type": "string",
          "description": "Groups all units processed in one transaction (one BA)"
        },
        "baNumber": {
          "type": "string",
          "description": "Stable Berita Acara number"
        },
        "penaltyAmount": {
          "type": "number"
        },
        "partPenaltyAmount": {
          "type": "number"
        },
        "damagedParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkedAssets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "referenceNo": {
          "type": "string"
        },
        "courier": {
          "type": "string"
        },
        "serviceVendor": {
          "type": "string"
        },
        "cost": {
          "type": "number"
        },
        "conditionAfter": {
          "type": "string"
        },
        "disposalMethod": {
          "type": "string"
        },
        "disposalValue": {
          "type": "number"
        },
        "keyZeroized": {
          "type": "boolean"
        },
        "supplierName": {
          "type": "string"
        },
        "poNumber": {
          "type": "string"
        },
        "swapWithSn": {
          "type": "string"
        },
        "tid": {
          "type": "string"
        },
        "mid": {
          "type": "string"
        },
        "approvalId": {
          "type": "string"
        }
      },
      "required": [
        "edcId",
        "type",
        "timestamp",
        "userId"
      ]
    },
    "userProfile": {
      "title": "User Profile",
      "description": "Application user. Login is username + password; email is the internal login email username@krispo-edc.local.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Internal login email (username@krispo-edc.local)"
        },
        "role": {
          "type": "string",
          "enum": [
            "Admin",
            "Operations",
            "Warehouse",
            "Service",
            "Account Manager",
            "Management"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Active",
            "Inactive"
          ]
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$"
        },
        "mustChangePassword": {
          "type": "boolean",
          "description": "User must replace the temporary password on next login"
        }
      },
      "required": [
        "email",
        "username",
        "role",
        "status"
      ]
    },
    "edcPart": {
      "title": "EDC Part",
      "description": "Master list of EDC components and replacement prices.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "price"
      ]
    },
    "supplier": {
      "title": "Supplier",
      "description": "Vendor / distributor that supplies devices.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "contactName": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "deviceModel": {
      "title": "Device Model",
      "description": "Brand and type of device, with default warranty.",
      "type": "object",
      "properties": {
        "brand": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "warrantyMonths": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "brand",
        "model"
      ]
    },
    "approval": {
      "title": "Approval",
      "description": "Maker-checker request for risky movements (Disposal, Lost, Return to Supplier, Cancel Termination).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assetSns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request": {
          "type": "object",
          "description": "Movement parameters executed after approval"
        },
        "summary": {
          "type": "string"
        },
        "estimatedPenalty": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending",
            "Approved",
            "Rejected",
            "Cancelled",
            "Executed"
          ]
        },
        "requestedBy": {
          "type": "string"
        },
        "requestedByName": {
          "type": "string"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decidedBy": {
          "type": "string"
        },
        "decidedByName": {
          "type": "string"
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisionNote": {
          "type": "string"
        },
        "executedBy": {
          "type": "string"
        },
        "executedByName": {
          "type": "string"
        },
        "executedAt": {
          "type": "string",
          "format": "date-time"
        },
        "baNumber": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "assetIds",
        "status",
        "requestedBy"
      ]
    },
    "attachment": {
      "title": "Attachment",
      "description": "File metadata. Content (base64) is stored in attachment_data/{same id}.",
      "type": "object",
      "properties": {
        "parentType": {
          "type": "string",
          "enum": [
            "movement",
            "approval",
            "asset"
          ]
        },
        "parentId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "uploadedBy": {
          "type": "string"
        },
        "uploadedByName": {
          "type": "string"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "parentType",
        "parentId",
        "name",
        "mimeType",
        "size",
        "uploadedBy"
      ]
    }
  },
  "firestore": {
    "edcs/{edcId}": {
      "schema": "edc",
      "description": "All assets: devices, SIM cards, peripherals"
    },
    "customers/{customerId}": {
      "schema": "customer",
      "description": "Collection of B2B customers"
    },
    "locations/{locationId}": {
      "schema": "location",
      "description": "Collection of various locations"
    },
    "contracts/{contractId}": {
      "schema": "contract",
      "description": "Legacy, unused"
    },
    "movements/{movementId}": {
      "schema": "movement",
      "description": "Audit trail for device movements"
    },
    "users/{userId}": {
      "schema": "userProfile",
      "description": "User account details"
    },
    "edc_parts/{partId}": {
      "schema": "edcPart",
      "description": "Master list of parts"
    },
    "suppliers/{supplierId}": {
      "schema": "supplier",
      "description": "Device suppliers"
    },
    "device_models/{modelId}": {
      "schema": "deviceModel",
      "description": "Device brands & types"
    },
    "approvals/{approvalId}": {
      "schema": "approval",
      "description": "Maker-checker requests"
    },
    "attachments/{attachmentId}": {
      "schema": "attachment",
      "description": "Attachment metadata"
    },
    "attachment_data/{attachmentId}": {
      "description": "Attachment content: { data: base64, uploadedBy }"
    }
  }
}
