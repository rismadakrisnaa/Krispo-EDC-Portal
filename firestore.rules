rules_version = '2';

// =====================================================================
// Channel Inventory Management - Firestore Security Rules
//
// Prinsip:
//  1. Login (username + password) saja TIDAK cukup. User harus punya profil
//     aktif di /users/{uid}, yang hanya bisa dibuat oleh Admin (atau oleh
//     admin pertama untuk dirinya sendiri, sekali saja).
//  2. Role TIDAK PERNAH bisa ditentukan sendiri oleh user.
//  3. Matriks hak akses di sini harus sama dengan src/lib/constants.ts.
//  4. Log pergerakan (movements) tidak bisa diubah setelah dibuat.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Identitas ----------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Username dipetakan ke email internal username@<domain>.
    // Harus sama dengan LOGIN_EMAIL_DOMAIN di src/lib/constants.ts.
    function loginEmail(username) {
      return username + '@krispo-edc.local';
    }

    // Admin pertama: akun dengan username 'admin'. Akun ini dibuat sekali lewat
    // tombol "Setup admin pertama" di halaman login; setelah ada, username itu
    // tidak bisa didaftarkan siapa pun lagi.
    // Harus sama dengan BOOTSTRAP_ADMIN_USERNAME di src/lib/constants.ts.
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email != null && myEmail() == loginEmail('admin');
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return isSignedIn() && exists(myProfilePath()) && get(myProfilePath()).data.get('status', 'Active') != 'Inactive';
    }

    function myRole() {
      return get(myProfilePath()).data.role;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (hasActiveProfile() && myRole() == 'Admin');
    }

    // Admin selalu lolos; role lain harus ada di daftar.
    function hasRole(roles) {
      return isAdmin() || (hasActiveProfile() && myRole() in roles);
    }

    // Semua user terdaftar & aktif boleh membaca data operasional.
    function canRead() {
      return isBootstrapAdmin() || hasActiveProfile();
    }

    // ---------------- Helper data ----------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRole(role) {
      return role in ['Admin', 'Operations', 'Warehouse', 'Service', 'Account Manager', 'Management'];
    }

    function optString(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }

    function optAmount(data, field) {
      return !(field in data) || data[field] == null || (data[field] is number && data[field] >= 0);
    }

    function isValidStatus(status) {
      return status in [
        'Incoming Stock', 'Available in Warehouse', 'Staged / Ready', 'Reserved / Allocated', 'In Delivery',
        'Installed / Active', 'Withdrawn', 'Under Repair', 'Damaged', 'Lost', 'Returned to Supplier', 'Retired'
      ];
    }

    function isValidAsset(data) {
      return data.sn is string && data.sn.size() > 0 && data.sn.size() <= 128 &&
             isValidStatus(data.status) &&
             (!('assetType' in data) || data.assetType in ['perangkat', 'sim', 'peripheral']) &&
             optString(data, 'vendor', 100) && optString(data, 'model', 100) &&
             optString(data, 'tid', 64) && optString(data, 'mid', 64) &&
             optString(data, 'customerName', 200) && optString(data, 'locationName', 200) &&
             optAmount(data, 'penaltyAmount') && optAmount(data, 'partPenaltyAmount') &&
             optAmount(data, 'currentMonthlyRental') && optAmount(data, 'purchasePrice') &&
             optAmount(data, 'disposalValue') && optString(data, 'assetTag', 64) && optString(data, 'poNumber', 64) &&
             optString(data, 'supplierName', 200);
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 128 &&
             optAmount(data, 'value') && optAmount(data, 'contractDuration') &&
             optString(data, 'address', 500) && optString(data, 'picName', 200);
    }

    function optCoordinate(data, field, limit) {
      return !(field in data) || data[field] == null ||
             (data[field] is number && data[field] >= -limit && data[field] <= limit);
    }

    function isValidLocation(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.type in ['Warehouse', 'Merchant Site', 'Service Center'] &&
             optString(data, 'address', 500) && optString(data, 'city', 100) && optString(data, 'province', 100) &&
             optString(data, 'region', 100) && optString(data, 'picName', 200) && optString(data, 'picPhone', 64) &&
             optCoordinate(data, 'latitude', 90) && optCoordinate(data, 'longitude', 180);
    }

    function isValidSupplier(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             optString(data, 'email', 128) && optString(data, 'phone', 64) && optString(data, 'address', 500) &&
             optString(data, 'notes', 500);
    }

    function isValidModel(data) {
      return data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100 &&
             data.model is string && data.model.size() > 0 && data.model.size() <= 100 &&
             optAmount(data, 'warrantyMonths') && optString(data, 'notes', 500);
    }

    function isValidPart(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             optString(data, 'description', 500);
    }

    function isValidMovement(data) {
      return data.edcId is string && data.edcId.size() <= 128 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 64 &&
             data.userId == request.auth.uid &&
             data.timestamp == request.time &&
             optString(data, 'notes', 2000) &&
             optAmount(data, 'penaltyAmount') && optAmount(data, 'partPenaltyAmount') &&
             optAmount(data, 'cost') && optAmount(data, 'disposalValue') && optString(data, 'referenceNo', 200);
    }

    // ---------------- Users ----------------
    function isValidUsername(username) {
      return username is string && username.matches('^[a-z0-9][a-z0-9._-]{2,31}$');
    }

    function isValidNewProfile(data) {
      return data.keys().hasOnly(['email', 'username', 'displayName', 'role', 'status', 'mustChangePassword', 'createdAt', 'updatedAt']) &&
             isValidUsername(data.username) &&
             data.email == loginEmail(data.username) &&
             isValidRole(data.role) &&
             data.status == 'Active' &&
             (!('mustChangePassword' in data) || data.mustChangePassword is bool) &&
             optString(data, 'displayName', 200);
    }

    match /users/{userId} {
      // Profil sendiri (dipakai saat login) atau Admin. User biasa tidak bisa melihat daftar user.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Admin membuat profil untuk akun user lain; admin pertama membuat profil Admin untuk dirinya.
      allow create: if isValidNewProfile(incoming()) && (
                      (isAdmin() && request.auth.uid != userId) ||
                      (isBootstrapAdmin() && request.auth.uid == userId &&
                       incoming().role == 'Admin' && incoming().email == myEmail())
                    );

      // Admin boleh ubah nama, role, dan status user LAIN. Role & status diri sendiri tidak bisa
      // diubah (mencegah eskalasi role dan mencegah admin terakhir mengunci dirinya sendiri).
      // User boleh mengubah namanya dan menandai password sementara sudah diganti.
      allow update: if incoming().email == existing().email &&
                    incoming().get('username', null) == existing().get('username', null) && (
                      (isAdmin() && request.auth.uid != userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'updatedAt']) &&
                       isValidRole(incoming().role) && incoming().status in ['Active', 'Inactive'] &&
                       optString(incoming(), 'displayName', 200)) ||
                      (request.auth.uid == userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'mustChangePassword', 'updatedAt']) &&
                       incoming().get('mustChangePassword', false) == false &&
                       optString(incoming(), 'displayName', 200))
                    );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ---------------- Aset (perangkat, SIM, peripheral) ----------------
    match /edcs/{edcId} {
      allow read: if canRead();
      allow create: if hasRole(['Operations', 'Warehouse']) && isValidAsset(incoming()) &&
                    incoming().assetType in ['perangkat', 'sim', 'peripheral'];
      // Serial number tidak bisa diganti setelah terdaftar.
      allow update: if hasRole(['Operations', 'Warehouse', 'Service']) && isValidAsset(incoming()) &&
                    incoming().sn == existing().sn;
      allow delete: if isAdmin();
    }

    // ---------------- Master data ----------------
    match /customers/{customerId} {
      allow read: if canRead();
      allow create, update: if hasRole(['Operations', 'Account Manager']) && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if canRead();
      allow create, update: if hasRole(['Operations', 'Warehouse']) && isValidLocation(incoming());
      allow delete: if isAdmin();
    }

    // Supplier / vendor EDC dan master brand & tipe perangkat.
    match /suppliers/{supplierId} {
      allow read: if canRead();
      allow create, update: if hasRole(['Operations', 'Warehouse']) && isValidSupplier(incoming());
      allow delete: if isAdmin();
    }

    match /device_models/{modelId} {
      allow read: if canRead();
      allow create, update: if hasRole(['Operations', 'Warehouse']) && isValidModel(incoming());
      allow delete: if isAdmin();
    }

    match /edc_parts/{partId} {
      allow read: if canRead();
      allow create, update: if hasRole(['Operations', 'Service']) && isValidPart(incoming());
      allow delete: if isAdmin();
    }

    // ---------------- Log pergerakan (audit trail) ----------------
    match /movements/{movementId} {
      allow read: if canRead();
      // Pencatat harus user yang sedang login, dengan waktu server.
      allow create: if hasRole(['Operations', 'Warehouse', 'Service']) && isValidMovement(incoming());
      allow update: if false; // audit trail tidak bisa diedit
      allow delete: if isAdmin(); // hanya untuk fitur reset data oleh Admin
    }

    // ---------------- Legacy ----------------
    // Koleksi lama, tidak dipakai aplikasi (kontrak sekarang melekat per unit di /edcs).
    match /contracts/{contractId} {
      allow read: if canRead();
      allow write: if isAdmin();
    }
  }
}
